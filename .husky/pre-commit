#!/bin/sh
#
# Execute lint-staged using Docker containers
# This requires both 'node_itsmint' and 'php_itsmint' containers to be running.
#

# Find docker executable
DOCKER_CMD=""
for path in /usr/local/bin/docker /opt/homebrew/bin/docker /usr/bin/docker; do
    if [ -x "$path" ]; then
        DOCKER_CMD="$path"
        break
    fi
done

if [ -z "$DOCKER_CMD" ]; then
    echo "Error: Docker not found. Please ensure Docker is installed and running."
    exit 1
fi

# Get container names from .env file
APP_NAME=$(grep '^APP_NAME=' .env 2>/dev/null | cut -d'=' -f2 || echo 'itsmint')
NODE_CONTAINER="node_${APP_NAME}"
PHP_CONTAINER="php_${APP_NAME}"

# Check if containers are running
if ! $DOCKER_CMD ps --format "table {{.Names}}" | grep -q "^${NODE_CONTAINER}$"; then
    echo "Error: Container ${NODE_CONTAINER} is not running."
    echo "Please start your Docker containers with: docker-compose up -d"
    exit 1
fi

if ! $DOCKER_CMD ps --format "table {{.Names}}" | grep -q "^${PHP_CONTAINER}$"; then
    echo "Error: Container ${PHP_CONTAINER} is not running."
    echo "Please start your Docker containers with: docker-compose up -d"
    exit 1
fi

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

# Filter files by extension
PHP_FILES=$(echo "$STAGED_FILES" | grep -E '\.php$')
JS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|ts|vue)$')

# Lint PHP files
if [ -n "$PHP_FILES" ]; then
    echo "Linting PHP files..."
    $DOCKER_CMD exec "$PHP_CONTAINER" ./vendor/bin/pint -- $PHP_FILES
    if [ $? -ne 0 ]; then
        echo "PHP linting failed."
        exit 1
    fi
fi

# Lint and format JS/TS/Vue files
if [ -n "$JS_FILES" ]; then
    echo "Linting and formatting JS/TS/Vue files..."
    $DOCKER_CMD exec "$NODE_CONTAINER" npx eslint --fix -- $JS_FILES
    if [ $? -ne 0 ]; then
        echo "JS linting failed."
        exit 1
    fi
    $DOCKER_CMD exec "$NODE_CONTAINER" npx prettier --write -- $JS_FILES
    if [ $? -ne 0 ]; then
        echo "JS formatting failed."
        exit 1
    fi
    # Re-add files to staging after formatting
    echo "$JS_FILES" | xargs git add
fi

exit 0 